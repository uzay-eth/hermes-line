        "ts": "2026-11-06T22:01:59.773+00:00"
      },
      {
        "seq": 7,
        "speaker": "business",
        "text": "I'll transfer your call now.",
        "ts": "2026-11-06T22:02:07.755+00:00"
      },
      {
        "seq": 8,
        "speaker": "business",
        "text": "The current phone wait time is 45 minutes.",
        "ts": "2026-11-06T22:02:13.664+00:00"
      },
      {
        "seq": 9,
        "speaker": "business",
        "text": "Instead of waiting on hold, you can message with a representative for faster service where the wait time is 0 minutes.",
        "ts": "2026-11-06T22:02:19.821+00:00"
      },
      {
        "seq": 10,
        "speaker": "business",
        "text": "Please say yes, and we'll send a message to your phone.",
        "ts": "2026-11-06T22:02:22.802+00:00"
      },
      {
        "seq": 11,
        "speaker": "business",
        "text": "Or you can say, no. Thanks.",
        "ts": "2026-11-06T22:02:25.140+00:00"
      },
      {
        "seq": 12,
        "speaker": "business",
        "text": "Sorry. Can you please repeat that?",
        "ts": "2026-11-06T22:02:31.388+00:00"
      },
      {
        "seq": 13,
        "speaker": "business",
        "text": "Sorry. Can you please repeat that?",
        "ts": "2026-11-06T22:02:37.673+00:00"
      },
      {
        "seq": 14,
        "speaker": "business",
        "text": "Sorry. Can you please repeat that?",
        "ts": "2026-11-06T22:02:43.907+00:00"
